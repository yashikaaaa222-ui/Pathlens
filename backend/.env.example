# Database. The default is a local SQLite file. For Supabase, paste the Postgres connection string
# (Project settings > Database) and install psycopg (see requirements.txt).
DATABASE_URL=sqlite:///./pathlens.db

# Required for every admin endpoint. If it is empty the admin endpoints return 503 (they are off, not open).
# Use a long random string. Never put it in the frontend bundle: type it into the admin page at runtime.
ADMIN_TOKEN=

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173

# Routing. With a free OpenRouteService key the foot-walking profile is used first.
ORS_API_KEY=
# Community OSRM foot profile, used when there is no key or the key fails. Not for heavy use.
FOOT_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Public OSM services require a User-Agent that identifies your app. Add a contact address.
HTTP_USER_AGENT=PathLens-prototype/0.1 (yashikaaaa222@gmail.com)
ROUTE_CACHE_SECONDS=3600

# Abuse limits, per client per hour (in memory, per server process).
REPORT_LIMIT_PER_HOUR=10
CONFIRM_LIMIT_PER_HOUR=30
COMPARE_LIMIT_PER_HOUR=60
CLASSIFY_LIMIT_PER_HOUR=300
DISPUTE_LIMIT_PER_HOUR=10
# Set to 1 only when the API sits behind a trusted proxy (Render, Fly, nginx) so the real client IP is used.
TRUST_PROXY=0
# Salt for the one-way client hash that stops one browser confirming the same report repeatedly.
# If empty a random salt is made at start-up, so the hashes reset on restart.
PRIVACY_SALT=

# ---- Sign-in (Supabase Auth) -------------------------------------------------------------------------------
# Set ONE of these and the API verifies the "Authorization: Bearer <access token>" header.
#   Newer projects (asymmetric signing keys): SUPABASE_URL, the public keys are fetched from
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Or give the keys address directly with SUPABASE_JWKS_URL.
#   Older projects (shared secret): SUPABASE_JWT_SECRET (Project settings > API > JWT secret). Server only.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# auto (default): reports, confirmations and disputes need a sign-in as soon as one of the settings above exists.
# 1: always required. 0: never required (prototype mode). Anonymous Supabase sessions never count as a sign-in.
REQUIRE_LOGIN=auto
# A moderator is an account whose app_metadata.role is "moderator" or "admin". Set it from the Supabase
# dashboard or a server-side script, never from user_metadata (users can edit that themselves).
# ADMIN_TOKEN above keeps working as a shared fallback; with no sign-in setup and no ADMIN_TOKEN the admin
# endpoints answer 503.

# ---- Photos and retention ----------------------------------------------------------------------------------
# Photos are rebuilt on the server (metadata removed) and shown to moderators only. Size cap after cleaning:
PHOTO_MAX_BYTES=150000
# Deleted automatically at start-up and by POST /api/admin/maintenance.
RETENTION_REJECTED_DAYS=30
RETENTION_UNVERIFIED_DAYS=180
RETENTION_PHOTO_DAYS=30
